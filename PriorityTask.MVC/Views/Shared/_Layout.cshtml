<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PriorityTask</title>

    <!-- Bootstrap CSS y Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            body {
                background-color: #0f172a !important; /* Fondo general oscuro */
                color: #f8fafc;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            /* Barra de navegación superior estilizada */
            .navbar-custom {
                background-color: #1e293b !important;
                border-bottom: 2px solid #22c55e;
                box-shadow: 0 4px 20px rgba(34, 197, 94, 0.15);
            }

            .navbar-brand-neon {
                color: #22c55e !important;
                font-weight: 700;
                font-size: 1.25rem;
                letter-spacing: 0.5px;
            }

            .nav-link-custom {
                color: #cbd5e1 !important;
                font-weight: 500;
                padding: 8px 16px !important;
                border-radius: 20px;
                transition: all 0.25s ease;
            }

            .nav-link-custom:hover {
                color: #22c55e !important;
                background-color: rgba(34, 197, 94, 0.1);
                transform: translateY(-1px);
            }

            .footer-custom {
                background-color: #1e293b;
                border-top: 1px solid #334155;
                color: #94a3b8;
            }
    </style>
</head>
<body translate="no">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark navbar-custom py-3 mb-4">
            <div class="container">
                <a class="navbar-brand navbar-brand-neon d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-check2-square fs-4"></i> PriorityTask
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 gap-1 ms-3">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Usuarios" asp-action="Index">
                                <i class="bi bi-people me-1"></i> Usuarios
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Materias" asp-action="Index">
                                <i class="bi bi-journal-bookmark me-1"></i> Materias
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Tareas" asp-action="Index">
                                <i class="bi bi-journal-bookmark me-1"></i> Tareas
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Subtareas" asp-action="Index">
                                <i class="bi bi-journal-bookmark me-1"></i> Subtareas
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Notas" asp-action="Index">
                                <i class="bi bi-journal-bookmark me-1"></i> Notas
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom py-3 text-center mt-auto">
        <div class="container">
            <small>&copy; 2026 - PriorityTask MVC | Panel de Administración</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
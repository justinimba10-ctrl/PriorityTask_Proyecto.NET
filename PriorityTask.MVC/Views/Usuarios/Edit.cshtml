@model PriorityTask.Modelos.Usuario

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <!-- CAMPOS OCULTOS MANDATORIOS -->
    @Html.HiddenFor(model => model.idUsuario)
    @Html.HiddenFor(model => model.fechaRegistro) 

    <div class="form-group mb-3">
        @Html.LabelFor(model => model.nombre, "Nombre")
        @Html.EditorFor(model => model.nombre, new { htmlAttributes = new { @class = "form-control" } })
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(model => model.email, "Correo")
        @Html.EditorFor(model => model.email, new { htmlAttributes = new { @class = "form-control" } })
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(model => model.password, "Contraseña")
        @Html.EditorFor(model => model.password, new { htmlAttributes = new { @class = "form-control" } })
    </div>

    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
}
@model IEnumerable<PriorityTask.Modelos.Materia>

@{
    ViewData["Title"] = "Gestión de Materias";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    body { background-color: #0f172a !important; color: #f8fafc; }
    .dark-card { background-color: #1e293b; border: 1px solid #334155; border-radius: 12px; transition: transform 0.2s ease; }
    .dark-card:hover { transform: translateY(-3px); }
    .header-neon { background-color: #1e293b; border-left: 5px solid #22c55e; border-radius: 8px; }
    .text-neon { color: #22c55e !important; }
    .btn-neon { background-color: #22c55e; color: #0f172a; font-weight: 600; border: none; }
    .btn-neon:hover { background-color: #16a34a; color: #fff; }
    .docente-box { background-color: #0f172a; border: 1px solid #334155; border-radius: 8px; }
</style>

<div class="container py-4">
    <div class="mb-4 p-4 header-neon shadow-sm d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold mb-1 text-white"><i class="bi bi-journal-bookmark-fill text-neon me-2"></i>Gestión de Materias</h3>
            <p class="text-muted mb-0 small">Consulta y administra las asignaturas y sus docentes asignados</p>
        </div>
        <a asp-action="Create" class="btn btn-neon rounded-pill px-3"><i class="bi bi-plus-lg me-1"></i> Nueva Materia</a>
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            // Determinamos el color de la tarjeta (si viene nulo de la base de datos, usa verde neón)
            var colorMateria = !string.IsNullOrEmpty(item.codigoColor) ? item.codigoColor : "#22c55e";

            <div class="col-md-4">
                <div class="card dark-card p-3 shadow-lg" style="border-top: 4px solid @colorMateria;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge rounded-pill bg-dark border text-white" style="border-color: @colorMateria !important;">
                            ID: #@item.idMateria
                        </span>
                    </div>

                    <h5 class="fw-bold text-white mb-3">@item.nombre</h5>

                    <div class="docente-box p-3 mb-3">
                        <small class="text-muted d-block mb-1">
                            <i class="bi bi-person-badge me-1" style="color: @colorMateria;"></i> Docente Asignado:
                        </small>
                        <span class="fw-semibold text-light">
                            @(string.IsNullOrEmpty(item.docente) ? "Sin docente asignado" : item.docente)
                        </span>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@item.idMateria" class="btn btn-outline-info btn-sm flex-fill rounded-pill">Ver</a>
                        <a asp-action="Edit" asp-route-id="@item.idMateria" class="btn btn-outline-warning btn-sm flex-fill rounded-pill">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.idMateria" class="btn btn-outline-danger btn-sm flex-fill rounded-pill">Borrar</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
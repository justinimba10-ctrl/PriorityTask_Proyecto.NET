@model PriorityTask.Modelos.Subtarea
@{ ViewData["Title"] = "Crear Subtarea"; }
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style>
    body { background-color: #0f172a !important; color: #f8fafc; }
    .dark-card { background-color: #1e293b; border: 1px solid #334155; border-radius: 12px; }
    .header-neon { background-color: #1e293b; border-left: 5px solid #22c55e; border-radius: 8px; }
    .text-neon { color: #22c55e !important; }
    .btn-neon { background-color: #22c55e; color: #0f172a; font-weight: 600; border: none; }
    .btn-neon:hover { background-color: #16a34a; color: #fff; }
    .form-control-dark, .form-select-dark { background-color: #0f172a; border: 1px solid #334155; color: #f8fafc; }
</style>

<div class="container py-4">
    <div class="mb-4 p-4 header-neon shadow-sm d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold mb-1 text-white"><i class="bi bi-diagram-2 text-neon me-2"></i>Nueva Subtarea</h3>
            <p class="text-muted mb-0 small">Desglosa una tarea principal en pasos más pequeños</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3"><i class="bi bi-arrow-left me-1"></i> Volver</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card dark-card p-4 shadow-lg">
                <form asp-action="Create">
                    <div class="mb-3">
                        <label class="form-label text-neon fw-bold">Tarea Principal</label>
                        <select asp-for="idTarea" class="form-select form-select-dark" asp-items="ViewBag.Tareas">
                            <option value="">-- Selecciona una Tarea --</option>
                        </select>
                        <span asp-validation-for="idTarea" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-neon fw-bold">Descripción de la Subtarea</label>
                        <input asp-for="descripcion" class="form-control form-control-dark" placeholder="Ej. Investigar marco teórico" />
                        <span asp-validation-for="descripcion" class="text-danger small"></span>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4">Cancelar</a>
                        <button type="submit" class="btn btn-neon rounded-pill px-4"><i class="bi bi-save me-1"></i> Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
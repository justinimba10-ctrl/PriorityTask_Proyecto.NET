@model PriorityTask.Modelos.Tarea

@{
    ViewData["Title"] = "Detalle de Tarea";

    // Evaluación del estado (Pendiente vs Completada)
    bool esCompletada = !string.IsNullOrEmpty(Model.estado) && 
                       (Model.estado.Equals("Completada", StringComparison.OrdinalIgnoreCase) || 
                        Model.estado.Equals("True", StringComparison.OrdinalIgnoreCase));

    string badgeColor = esCompletada ? "bg-success text-white" : "bg-warning text-dark";
    string badgeIcon = esCompletada ? "bi-check-circle-fill" : "bi-clock-history";
    string textoEstado = esCompletada ? "Completada" : "Pendiente";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    body { background-color: #0f172a !important; color: #f8fafc; }
    .dark-card { background-color: #1e293b; border: 1px solid #334155; border-radius: 12px; }
    .inner-box { background-color: #0f172a; border: 1px solid #334155; border-radius: 8px; }
    .text-neon { color: #22c55e !important; }
    .btn-neon { background-color: #22c55e; color: #0f172a; font-weight: 600; border: none; }
    .btn-neon:hover { background-color: #16a34a; color: #fff; }
</style>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card dark-card p-4 shadow-lg">
                
                <!-- Encabezado con ID y Badge de Estado Dinámico -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge rounded-pill bg-dark border border-secondary text-white px-3 py-2">
                        ID: #@Model.idTarea
                    </span>

                    <span class="badge rounded-pill @badgeColor px-3 py-2 fw-bold">
                        <i class="bi @badgeIcon me-1"></i> @textoEstado
                    </span>
                </div>

                <!-- Título de la Tarea -->
                <h3 class="fw-bold text-white mb-4">@Model.titulo</h3>

                <!-- Detalle de la Materia y Fecha -->
                <div class="inner-box p-3 mb-4">
                    <p class="mb-2">
                        <strong class="text-neon">Materia:</strong> 
                        <span class="text-white">@(Model.materia?.nombre ?? "Sin materia asignada")</span>
                    </p>
                    
                    <p class="mb-2">
                        <strong class="text-neon">Docente:</strong> 
                        <span class="text-white">@(Model.materia?.docente ?? "Sin docente asignado")</span>
                    </p>

                    <p class="mb-2">
                        <strong class="text-neon">Prioridad:</strong> 
                        <span class="badge bg-secondary">@Model.prioridad</span>
                    </p>

                    <p class="mb-0">
                        <strong class="text-neon">Fecha Límite:</strong> 
                        @if (Model.fechaLimite.Year > 1)
                        {
                            <span class="text-white">@Model.fechaLimite.ToString("dd/MM/yyyy HH:mm")</span>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Sin fecha asignada</span>
                        }
                    </p>
                </div>

                <!-- Descripción -->
                <h6 class="text-neon fw-bold mb-2">Descripción</h6>
                <div class="inner-box p-3 mb-4">
                    <p class="text-light mb-0">
                        @(string.IsNullOrEmpty(Model.descripcion) ? "Sin descripción provista." : Model.descripcion)
                    </p>
                </div>

                <!-- Botones de Acción -->
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.idTarea" class="btn btn-outline-warning rounded-pill px-4">
                        <i class="bi bi-pencil me-1"></i> Editar
                    </a>
                    <a asp-action="Index" class="btn btn-neon rounded-pill px-4">
                        Aceptar
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>
@model PriorityTask.Modelos.Nota

@{
    ViewData["Title"] = "Detalles de la Nota";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    body { background-color: #0f172a !important; color: #f8fafc; }
    .dark-card { background-color: #1e293b; border: 1px solid #334155; border-radius: 12px; }
    .header-neon { background-color: #1e293b; border-left: 5px solid #22c55e; border-radius: 8px; }
    .text-neon { color: #22c55e !important; }
    .btn-neon { background-color: #22c55e; color: #0f172a; font-weight: 600; border: none; }
    .btn-neon:hover { background-color: #16a34a; color: #ffffff; }
</style>

<div class="container py-4">
    <div class="mb-4 p-4 header-neon shadow-sm d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold mb-1 text-white">
                <i class="bi bi-info-circle text-neon me-2"></i>Detalles de la Nota
            </h3>
            <p class="text-muted mb-0 small">Consulta la información detallada de la nota</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card dark-card p-4 shadow-lg">
                <div class="mb-3 pb-2 border-bottom border-secondary">
                    <span class="badge bg-dark text-neon border border-emerald-500 rounded-pill px-3 py-1 mb-2">
                        ID: #@Model.idNota
                    </span>
                    <h4 class="fw-bold text-white mb-0">@Model.titulo</h4>
                </div>

                <div class="mb-3">
                    <label class="text-neon fw-bold d-block">Materia Asociada</label>
                    <span class="fs-6 text-light">@(ViewBag.NombreMateria ?? "Sin Asignar")</span>
                </div>

                <div class="mb-4">
                    <label class="text-neon fw-bold d-block">Contenido de la Nota</label>
                    <div class="p-3 bg-dark rounded border border-secondary text-slate-300">
                        @Model.contenido
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.idNota" class="btn btn-outline-warning rounded-pill px-4">
                        <i class="bi bi-pencil me-1"></i> Editar
                    </a>
                    <a asp-action="Index" class="btn btn-neon rounded-pill px-4">Aceptar</a>
                </div>
            </div>
        </div>
    </div>
</div>
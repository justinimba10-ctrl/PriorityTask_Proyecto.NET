@model PriorityTask.Modelos.Nota

@{
    ViewData["Title"] = "Crear Nota";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    body { background-color: #0f172a !important; color: #f8fafc; }
    .dark-card { background-color: #1e293b; border: 1px solid #334155; border-radius: 12px; }
    .header-neon { background-color: #1e293b; border-left: 5px solid #22c55e; border-radius: 8px; }
    .text-neon { color: #22c55e !important; }
    .btn-neon { background-color: #22c55e; color: #0f172a; font-weight: 600; border: none; }
    .btn-neon:hover { background-color: #16a34a; color: #ffffff; }
    .form-control-dark, .form-select-dark { background-color: #0f172a; border: 1px solid #334155; color: #f8fafc; }
    .form-control-dark:focus, .form-select-dark:focus { background-color: #0f172a; border-color: #22c55e; color: #fff; box-shadow: 0 0 8px rgba(34, 197, 94, 0.4); }
</style>

<div class="container py-4">
    <div class="mb-4 p-4 header-neon shadow-sm d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold mb-1 text-white">
                <i class="bi bi-plus-circle text-neon me-2"></i>Nueva Nota
            </h3>
            <p class="text-muted mb-0 small">Ingresa la información de la nueva nota</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Volver a la Lista
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card dark-card p-4 shadow-lg">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label text-neon fw-bold">Materia</label>
                        <select asp-for="idMateria" class="form-select form-select-dark" asp-items="ViewBag.Materias">
                            <option value="">-- Seleccione una Materia --</option>
                        </select>
                        <span asp-validation-for="idMateria" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-neon fw-bold">Título de la Nota</label>
                        <input asp-for="titulo" class="form-control form-control-dark" placeholder="Ej. Comandos de Git" />
                        <span asp-validation-for="titulo" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-neon fw-bold">Contenido</label>
                        <textarea asp-for="contenido" class="form-control form-control-dark" rows="4" placeholder="Escribe el detalle de tu nota aquí..."></textarea>
                        <span asp-validation-for="contenido" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4">Cancelar</a>
                        <button type="submit" class="btn btn-neon rounded-pill px-4">
                            <i class="bi bi-save me-1"></i> Guardar Nota
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@model PriorityTask.Modelos.Nota

@{
    ViewData["Title"] = "Eliminar Nota";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    body { background-color: #0f172a !important; color: #f8fafc; }
    .dark-card { background-color: #1e293b; border: 1px solid #334155; border-radius: 12px; }
    .header-danger { background-color: #1e293b; border-left: 5px solid #ef4444; border-radius: 8px; }
    .text-danger-custom { color: #ef4444 !important; }
</style>

<div class="container py-4">
    <div class="mb-4 p-4 header-danger shadow-sm d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold mb-1 text-white">
                <i class="bi bi-exclamation-triangle text-danger-custom me-2"></i>Eliminar Nota
            </h3>
            <p class="text-muted mb-0 small">¿Estás seguro de que deseas eliminar este registro?</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Cancelar
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card dark-card p-4 shadow-lg border-danger">
                <div class="mb-3 pb-2 border-bottom border-secondary">
                    <span class="badge bg-danger text-white rounded-pill px-3 py-1 mb-2">
                        ID: #@Model.idNota
                    </span>
                    <h4 class="fw-bold text-white mb-0">@Model.titulo</h4>
                </div>

                <div class="mb-3">
                    <label class="text-danger-custom fw-bold d-block">Materia</label>
                    <span class="fs-6 text-light">@(ViewBag.NombreMateria ?? "Sin Asignar")</span>
                </div>

                <div class="mb-4">
                    <label class="text-danger-custom fw-bold d-block">Contenido</label>
                    <p class="text-slate-300">@Model.contenido</p>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="idNota" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4">Cancelar</a>
                        <button type="submit" class="btn btn-danger rounded-pill px-4">
                            <i class="bi bi-trash me-1"></i> Confirmar Eliminación
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>